{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(scripts/.*|styles.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/x/s.js",
      "destination": "https://analytics.markusevanger.no/script.js"
    },
    {
      "source": "/x/api/send",
      "destination": "https://analytics.markusevanger.no/api/send"
    }
  ]
}
